// Cloudflare Workers (Static Assets). Workers Builds ejecuta `npm run build` y luego `npx wrangler deploy`.
{
  "name": "cumbia-reverb-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // Sin código de servidor: solo archivos estáticos. Los headers de seguridad están en public/_headers.
  "workers_dev": true,
  "preview_urls": false
}
